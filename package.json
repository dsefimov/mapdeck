{
    "name": "mapdeck",
    "version": "1.2.2",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist",
        "README.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/app/index.d.ts",
            "import": "./dist/mapdeck.js"
        },
        "./contracts": {
            "types": "./dist/app/contracts.d.ts",
            "import": "./dist/contracts.js"
        },
        "./ui": {
            "types": "./dist/app/ui.d.ts",
            "import": "./dist/ui.js"
        },
        "./utils": {
            "types": "./dist/app/utils.d.ts",
            "import": "./dist/utils.js"
        },
        "./styles.css": "./dist/mapdeck.css",
        "./package.json": "./package.json"
    },
    "main": "./dist/mapdeck.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build:lib": "vite build --config vite.lib.config.ts",
        "preview": "vite preview",
        "prepack": "npm run lint && npm run test && npm run build:lib",
        "lint": "tsc --noEmit && eslint --max-warnings=0",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "prepare": "node scripts/install-git-hooks.mjs",
        "license-check": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;CC0-1.0;0BSD;Unlicense\" --excludePackages \"@mapbox/jsonlint-lines-primitives\" --summary"
    },
    "peerDependencies": {
        "mobx": "^6.15.0",
        "mobx-react-lite": "^4.1.1",
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0"
    },
    "dependencies": {
        "@deck.gl/core": "^9.2.7",
        "@deck.gl/layers": "^9.2.7",
        "@deck.gl/mapbox": "^9.2.7",
        "@turf/area": "^7.3.5",
        "@turf/bbox": "^7.3.5",
        "@turf/bbox-polygon": "^7.3.5",
        "@turf/boolean-intersects": "^7.3.5",
        "@turf/distance": "^7.3.4",
        "@turf/helpers": "^7.4.0",
        "copc": "^0.0.8",
        "delaunator": "^5.1.0",
        "laz-perf": "^0.0.7",
        "maplibre-gl": "^5.21.0",
        "pmtiles": "^4.0.0",
        "proj4": "^2.20.4",
        "rbush": "^4.0.1",
        "react-grid-layout": "^2.2.2"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^25.0.5",
        "@types/rbush": "^4.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/react-grid-layout": "^1.3.6",
        "@typescript-eslint/eslint-plugin": "^8.57.0",
        "@typescript-eslint/parser": "^8.0.0",
        "@vitejs/plugin-react": "^6.0.0",
        "eslint": "^9.14.0",
        "eslint-plugin-jsdoc": "^64.2.0",
        "eslint-plugin-react": "^7.37.0",
        "eslint-plugin-react-hooks": "^7.0.0",
        "eslint-plugin-sonarjs": "^4.0.0",
        "happy-dom": "^20.14.5",
        "license-checker-rseidelsohn": "^4.4.2",
        "mobx": "^6.15.0",
        "mobx-react-lite": "^4.1.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "^5.2.0",
        "vite": "^8.0.0",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^4.1.9"
    }
}
